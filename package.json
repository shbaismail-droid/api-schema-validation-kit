{
  "name": "api-schema-validation-kit",
  "version": "1.1.0",
  "description": "Production-ready JSON Schema validation toolkit for API payloads and data contracts.",
  "main": "src/index.js",
  "bin": {
    "api-schema-validation-kit": "src/cli.js"
  },
  "type": "commonjs",
  "files": [
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node src/cli.js",
    "test": "node tests/validator.test.js",
    "start": "node src/cli.js --schema schemas/user.schema.json --data examples/valid-user.json"
  },
  "keywords": [
    "json-schema",
    "api",
    "validation",
    "data-contracts",
    "open-source",
    "schema",
    "ajv"
  ],
  "author": "Sami Hassan Baismail <shbaismail@gmail.com> (https://github.com/shbaismail-droid)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbaismail-droid/api-schema-validation-kit.git"
  },
  "homepage": "https://github.com/shbaismail-droid/api-schema-validation-kit#readme",
  "bugs": {
    "url": "https://github.com/shbaismail-droid/api-schema-validation-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  }
}
